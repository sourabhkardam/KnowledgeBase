    {
      "id": "xjdCun2zxdGW_A352YX_n",
      "type": "text",
      "x": 386.6059551756356,
      "y": -1523.9352926779873,
      "width": 539.8196411132812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
