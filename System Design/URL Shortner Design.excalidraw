      "index": "aH",
      "roundness": null,
      "seed": 299893216,
      "version": 510,
      "versionNonce": 491229147,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786528984372,
      "link": null,
      "locked": false,
      "text": "Note: Start from the basic design first and then scale.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
